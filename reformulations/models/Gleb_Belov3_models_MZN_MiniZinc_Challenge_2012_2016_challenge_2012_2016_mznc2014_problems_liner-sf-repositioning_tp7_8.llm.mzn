include "globals.mzn";

function array[int] of int: rf_unpack(array[int] of int: rf_encoded, int: rf_width) =
    let {
        array[int] of int: rf_markers =
            [rf_i | rf_i in index_set(rf_encoded) where rf_encoded[rf_i] < 0];
    } in
    [
        let {
            int: rf_begin = rf_markers[rf_r];
            int: rf_missing = -rf_encoded[rf_begin] - 1;
            int: rf_end =
                if rf_r < length(rf_markers) then
                    rf_markers[rf_r + 1] - 1
                else
                    max(index_set(rf_encoded))
                endif;
        } in
        if rf_w <= rf_missing then -1
        else rf_encoded[min(rf_begin + rf_w - rf_missing, rf_end)]
        endif
        | rf_r in index_set(rf_markers), rf_w in 1..rf_width
    ];

