-10,75992,2701,
-11,206891,
-10,328803,137572,
-11,278269
],card(WEEKS)));

int: sosActBCostMax = max([
    max(array1d(sosSailCostBArr0)),
    max(array1d(sosSailCostBArr1)),
    max(array1d(sosSailCostBArr2)),
    max(array1d(sosSailCostBArr3)),
    max(array1d(sosSailCostBArr4)),
    max(array1d(sosSailCostBArr5))
]);
int: sosActACostMax = max(array1d(sosSailCostAArr));
int: sosActSavingsMin = min(array1d(sosActSavingsArr));
int: directCostMax = max([
    max(array1d(directCostArr0)),
    max(array1d(directCostArr1)),
    max(array1d(directCostArr2)),
    max(array1d(directCostArr3)),
    max(array1d(directCostArr4)),
    max(array1d(directCostArr5))
]);

var POPORTS0: poAct0;
var POPORTS1: poAct1;
var POPORTS2: poAct2;
var POPORTS3: poAct3;
var POPORTS4: poAct4;
var POPORTS5: poAct5;
var PIPORTS: piPort;
array[VESSELS] of var WEEKS: piWeek;
array[VESSELS] of var REPOSTYPES: reposType;
array[VESSELS] of var SOSACTS: sosAct;
array[VESSELS] of var SOS: sos;
array[VESSELS] of var sosActSavingsMin..0: sosActSavings;
array[VESSELS] of var 0..directCostMax: directCost;
array[VESSELS] of var 0..sosActBCostMax: sosActBCost;
array[VESSELS] of var 0..sosActACostMax: sosActACost;

int: maxCost = 500000;

array[index_set_1of2(piTimes)] of var 0..1: rf_port;
array[index_set(piWeek),index_set_2of2(piTimes)] of var 0..1: rf_week;
array[index_set(sosAct),index_set(sosIds)] of var 0..1: rf_activity;

set of int: rf_start_domain =
    min(index_set_2of2(piTimes))..
    (max(index_set_2of2(piTimes)) - length(piWeek) + 1);
array[rf_start_domain] of var 0..1: rf_start;

int: rf_hotel_lower = -88 * max([
    max(poTimes0),max(poTimes1),max(poTimes2),
    max(poTimes3),max(poTimes4),max(poTimes5)
]);
int: rf_hotel_upper = 88 * max(array1d(piTimes));
array[index_set(piWeek)] of var rf_hotel_lower..rf_hotel_upper: rf_hotel;

constraint sum(rf_port) = 1;
constraint piPort = sum(rf_p in index_set(rf_port))(rf_p * rf_port[rf_p]);
constraint sum(rf_start) = 1;
constraint forall(rf_w in index_set_2of2(rf_week))(
    sum(rf_v in index_set_1of2(rf_week))(rf_week[rf_v,rf_w]) =
    sum(rf_t in index_set(rf_start)
        where rf_t <= rf_w /\ rf_w < rf_t + length(piWeek))(rf_start[rf_t])
);
constraint forall(rf_v in VESSELS)(
    sum(rf_w in WEEKS)(rf_week[rf_v,rf_w]) = 1 /\
    piWeek[rf_v] = sum(rf_w in WEEKS)(rf_w * rf_week[rf_v,rf_w]) /\
    sum(rf_s in SOSACTS)(rf_activity[rf_v,rf_s]) = 1 /\
    sosAct[rf_v] = sum(rf_s in SOSACTS)(rf_s * rf_activity[rf_v,rf_s]) /\
    sos[rf_v] = sum(rf_s in SOSACTS)(sosIds[rf_s] * rf_activity[rf_v,rf_s]) /\
    reposType[rf_v] = 2 - rf_activity[rf_v,0] /\
    sosActSavings[rf_v] =
        sum(rf_s in SOSACTS)(sosActSavingsArr[rf_v,rf_s] * rf_activity[rf_v,rf_s])
);
constraint forall(rf_s in SOSACTS where rf_s != 0)(
    sum(rf_v in VESSELS)(rf_activity[rf_v,rf_s]) <= 1
);
constraint forall(rf_id in SOS where rf_id != 0)(
    sum(rf_v in VESSELS, rf_s in SOSACTS where sosIds[rf_s] = rf_id)(
        rf_activity[rf_v,rf_s]
    ) <= 1
);

predicate rf_vessel(
    int: rf_vessel_id,
    int: rf_rate,
    array[int] of int: rf_out_times,
    array[int,int,int] of int: rf_direct_data,
    array[int,int] of int: rf_before_data,
    var int: rf_out_choice
) =
    let {
        array[int] of int: rf_d_out = [
            rf_o
            | rf_o in index_set_1of3(rf_direct_data),
              rf_p in index_set_2of3(rf_direct_data),
              rf_w in index_set_3of3(rf_direct_data)
            where rf_direct_data[rf_o,rf_p,rf_w] >= 0
        ];
        array[index_set(rf_d_out)] of int: rf_d_port = [
            rf_p
            | rf_o in index_set_1of3(rf_direct_data),
              rf_p in index_set_2of3(rf_direct_data),
              rf_w in index_set_3of3(rf_direct_data)
            where rf_direct_data[rf_o,rf_p,rf_w] >= 0
        ];
        array[index_set(rf_d_out)] of int: rf_d_week = [
            rf_w
            | rf_o in index_set_1of3(rf_direct_data),
              rf_p in index_set_2of3(rf_direct_data),
              rf_w in index_set_3of3(rf_direct_data)
            where rf_direct_data[rf_o,rf_p,rf_w] >= 0
        ];
        array[index_set(rf_d_out)] of var 0..1: rf_d_select;

        array[int] of int: rf_b_out = [
            rf_o
            | rf_o in index_set_1of2(rf_before_data),
              rf_s in index_set_2of2(rf_before_data)
            where rf_s != 0 /\ rf_before_data[rf_o,rf_s] >= 0
        ];
        array[index_set(rf_b_out)] of int: rf_b_activity = [
            rf_s
            | rf_o in index_set_1of2(rf_before_data),
              rf_s in index_set_2of2(rf_before_data)
            where rf_s != 0 /\ rf_before_data[rf_o,rf_s] >= 0
        ];
        array[index_set(rf_b_out)] of var 0..1: rf_b_select;

        array[int] of int: rf_a_port = [
            rf_p
            | rf_p in PIPORTS, rf_w in WEEKS, rf_s in SOSACTS
            where rf_s != 0 /\ sosSailCostAArr[rf_vessel_id,rf_p,rf_w,rf_s] >= 0
        ];
        array[index_set(rf_a_port)] of int: rf_a_week = [
            rf_w
            | rf_p in PIPORTS, rf_w in WEEKS, rf_s in SOSACTS
            where rf_s != 0 /\ sosSailCostAArr[rf_vessel_id,rf_p,rf_w,rf_s] >= 0
        ];
        array[index_set(rf_a_port)] of int: rf_a_activity = [
            rf_s
            | rf_p in PIPORTS, rf_w in WEEKS, rf_s in SOSACTS
            where rf_s != 0 /\ sosSailCostAArr[rf_vessel_id,rf_p,rf_w,rf_s] >= 0
        ];
        array[index_set(rf_a_port)] of var 0..1: rf_a_select;
    } in
    sum(rf_d_select) = rf_activity[rf_vessel_id,0] /\
    forall(rf_s in SOSACTS where rf_s != 0)(
        sum(rf_j in index_set(rf_b_select) where rf_b_activity[rf_j] = rf_s)(
            rf_b_select[rf_j]
        ) = rf_activity[rf_vessel_id,rf_s] /\
        sum(rf_j in index_set(rf_a_select) where rf_a_activity[rf_j] = rf_s)(
            rf_a_select[rf_j]
        ) = rf_activity[rf_vessel_id,rf_s]
    ) /\
    forall(rf_p in PIPORTS)(
        sum(rf_j in index_set(rf_d_select) where rf_d_port[rf_j] = rf_p)(
            rf_d_select[rf_j]
        ) +
        sum(rf_j in index_set(rf_a_select) where rf_a_port[rf_j] = rf_p)(
            rf_a_select[rf_j]
        ) = rf_port[rf_p]
    ) /\
    forall(rf_w in WEEKS)(
        sum(rf_j in index_set(rf_d_select) where rf_d_week[rf_j] = rf_w)(
            rf_d_select[rf_j]
        ) +
        sum(rf_j in index_set(rf_a_select) where rf_a_week[rf_j] = rf_w)(
            rf_a_select[rf_j]
        ) = rf_week[rf_vessel_id,rf_w]
    ) /\
    rf_out_choice =
        sum(rf_j in index_set(rf_d_select))(rf_d_out[rf_j] * rf_d_select[rf_j]) +
        sum(rf_j in index_set(rf_b_select))(rf_b_out[rf_j] * rf_b_select[rf_j]) /\
    directCost[rf_vessel_id] =
        sum(rf_j in index_set(rf_d_select))(
            rf_direct_data[rf_d_out[rf_j],rf_d_port[rf_j],rf_d_week[rf_j]]
            * rf_d_select[rf_j]
        ) /\
    sosActBCost[rf_vessel_id] =
        sum(rf_j in index_set(rf_b_select))(
            rf_before_data[rf_b_out[rf_j],rf_b_activity[rf_j]] * rf_b_select[rf_j]
        ) /\
    sosActACost[rf_vessel_id] =
        sum(rf_j in index_set(rf_a_select))(
            sosSailCostAArr[
                rf_vessel_id,rf_a_port[rf_j],rf_a_week[rf_j],rf_a_activity[rf_j]
            ] * rf_a_select[rf_j]
        ) /\
    rf_hotel[rf_vessel_id] = rf_rate * (
        sum(rf_j in index_set(rf_d_select))(
            (piTimes[rf_d_port[rf_j],rf_d_week[rf_j]] - rf_out_times[rf_d_out[rf_j]])
            * rf_d_select[rf_j]
        ) +
        sum(rf_j in index_set(rf_a_select))(
            piTimes[rf_a_port[rf_j],rf_a_week[rf_j]] * rf_a_select[rf_j]
        ) -
        sum(rf_j in index_set(rf_b_select))(
            rf_out_times[rf_b_out[rf_j]] * rf_b_select[rf_j]
        )
    );

constraint rf_vessel(1,88,poTimes0,directCostArr0,sosSailCostBArr0,poAct0);
constraint rf_vessel(2,88,poTimes1,directCostArr1,sosSailCostBArr1,poAct1);
constraint rf_vessel(3,66,poTimes2,directCostArr2,sosSailCostBArr2,poAct2);
constraint rf_vessel(4,66,poTimes3,directCostArr3,sosSailCostBArr3,poAct3);
constraint rf_vessel(5,66,poTimes4,directCostArr4,sosSailCostBArr4,poAct4);
constraint rf_vessel(6,66,poTimes5,directCostArr5,sosSailCostBArr5,poAct5);

constraint sum(directCost) + sum(sosActSavings) +
           sum(sosActBCost) + sum(sosActACost) < maxCost;

int: objectiveMax = ub(
    88 * (piTimes[piPort,piWeek[1]] - poTimes0[poAct0]) +
    88 * (piTimes[piPort,piWeek[2]] - poTimes1[poAct1]) +
    66 * (piTimes[piPort,piWeek[3]] - poTimes2[poAct2]) +
    66 * (piTimes[piPort,piWeek[4]] - poTimes3[poAct3]) +
    66 * (piTimes[piPort,piWeek[5]] - poTimes4[poAct4]) +
    66 * (piTimes[piPort,piWeek[6]] - poTimes5[poAct5]) +
    sum(directCost) - sum(sosActSavings) +
    sum(sosActBCost) + sum(sosActACost)
);

var 0..objectiveMax: objective =
    sum(rf_hotel) + sum(directCost) - sum(sosActSavings) +
    sum(sosActBCost) + sum(sosActACost);

solve minimize objective;

output [
    "poAct0 = ", show(poAct0), ";\n",
    "poAct1 = ", show(poAct1), ";\n",
    "poAct2 = ", show(poAct2), ";\n",
    "poAct3 = ", show(poAct3), ";\n",
    "poAct4 = ", show(poAct4), ";\n",
    "poAct5 = ", show(poAct5), ";\n",
    "piPort = ", show(piPort), ";\n",
    "piWeek = ", show(piWeek), ";\n",
    "reposType = ", show(reposType), ";\n",
    "sosAct = ", show(sosAct), ";\n",
    "sos = ", show(sos), ";\n",
    "sosActSavings = ", show(sosActSavings), ";\n",
    "directCost = ", show(directCost), ";\n",
    "sosActBCost = ", show(sosActBCost), ";\n",
    "sosActACost = ", show(sosActACost), ";\n",
    "constraint objective = ", show(objective), ";\n"
];