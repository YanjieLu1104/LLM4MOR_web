param NLojas;
param Lojas{i in 1..NLojas};
param Produto;
param produto{i in 1..Produto};
param custo{i in 1..NLojas, j in 1..NLojas};
param Disponibilidade{i in 1..NLojas, k in 1..Produto};
param Procura{j in 1..NLojas, k in 1..Produto};

param rf4_cap{i in 1..NLojas, j in 1..NLojas, k in 1..Produto}
    := if i = j and i <= NLojas-1 then 0
       else min(Disponibilidade[i,k]/5, Procura[j,k]/5);

param rf4_arc_cap{i in 1..NLojas, j in 1..NLojas}
    := min(1000000, sum{k in 1..Produto} rf4_cap[i,j,k]);

var caixas{i in 1..NLojas, j in 1..NLojas, k in 1..Produto}
    >= 0, <= rf4_cap[i,j,k];
var Envios{i in 1..NLojas, j in 1..NLojas}, binary;

minimize EnviosTotal:
    sum{i in 1..NLojas, j in 1..NLojas} custo[i,j]*Envios[i,j];

subject to Packing{i in 1..NLojas, j in 1..NLojas}:
    sum{k in 1..Produto} caixas[i,j,k]
    <= rf4_arc_cap[i,j]*Envios[i,j];

subject to Disponivel{i in 1..NLojas, k in 1..Produto}:
    sum{j in 1..NLojas} caixas[i,j,k] = Disponibilidade[i,k]/5;

subject to PROCURA{j in 1..NLojas, k in 1..Produto}:
    sum{i in 1..NLojas} caixas[i,j,k] = Procura[j,k]/5;

subject to rf4_link{i in 1..NLojas, j in 1..NLojas, k in 1..Produto:
                    rf4_cap[i,j,k] > 0}:
    caixas[i,j,k] <= rf4_cap[i,j,k]*Envios[i,j];

data;
param Produto := 5;
param NLojas := 101;

