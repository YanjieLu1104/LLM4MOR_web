];

array[int] of var 0..279: rf13_arrival = [
    expectedArrivalTime11026, expectedArrivalTime11029,
    expectedArrivalTime11040, expectedArrivalTime11043,
    expectedArrivalTime11054, expectedArrivalTime11057,
    expectedArrivalTime11068, expectedArrivalTime11071,
    expectedArrivalTime11082, expectedArrivalTime11085,
    expectedArrivalTime11096, expectedArrivalTime11099,
    expectedArrivalTime11110, expectedArrivalTime11113
];

array[int] of var 1..15: rf13_arrival_lookup = [
    expectedArrivalTimeX14, expectedArrivalTimeX15,
    expectedArrivalTimeX16, expectedArrivalTimeX17,
    expectedArrivalTimeX18, expectedArrivalTimeX19,
    expectedArrivalTimeX20, expectedArrivalTimeX21,
    expectedArrivalTimeX22, expectedArrivalTimeX23,
    expectedArrivalTimeX24, expectedArrivalTimeX25,
    expectedArrivalTimeX26, expectedArrivalTimeX27
];

array[int] of var 1..279: rf13_cumulative = [
    mapget1048, binop2235, binop2945, binop3655,
    binop4365, binop5075, binop5785, binop6495,
    binop7205, binop7915, binop8625, binop9335,
    binop10045, binop10755
];

set of int: rf13_nodes = index_set(rf13_depot);
set of int: rf13_positions = index_set(rf13_location);
int: rf13_n = length(rf13_depot);
int: rf13_first = min(rf13_positions);
int: rf13_last = max(rf13_positions);
set of int: rf13_vertices = 0..rf13_n;
int: rf13_min_edge =
    min(rf13_i in index_set_1of2(rf13_distance),
        rf13_j in index_set_2of2(rf13_distance)
        where rf13_i != rf13_j)(rf13_distance[rf13_i,rf13_j]);
int: rf13_max_edge =
    max(rf13_i in index_set_1of2(rf13_distance),
        rf13_j in index_set_2of2(rf13_distance)
        where rf13_i != rf13_j)(rf13_distance[rf13_i,rf13_j]);
int: rf13_time_bound =
    max(rf13_depot) + (rf13_n - 1) * rf13_max_edge;

array[rf13_nodes,rf13_positions] of var 0..1: rf13_assignment;
array[rf13_vertices,rf13_vertices] of var 0..1: rf13_arc;

constraint forall(rf13_i in rf13_nodes)(
    sum(rf13_p in rf13_positions)(rf13_assignment[rf13_i,rf13_p]) = 1
);

constraint forall(rf13_p in rf13_positions)(
    sum(rf13_i in rf13_nodes)(rf13_assignment[rf13_i,rf13_p]) = 1
);

constraint forall(rf13_i in rf13_nodes)(
    rf13_order[rf13_i] =
        sum(rf13_p in rf13_positions)(
            (rf13_p - rf13_first) * rf13_assignment[rf13_i,rf13_p]
        )
);

constraint forall(rf13_p in rf13_positions)(
    rf13_location[rf13_p] =
        sum(rf13_i in rf13_nodes)(
            rf13_i * rf13_assignment[rf13_i,rf13_p]
        )
);

constraint forall(rf13_i in rf13_vertices)(
    rf13_arc[rf13_i,rf13_i] = 0
);

constraint forall(rf13_i in rf13_vertices)(
    sum(rf13_j in rf13_vertices)(rf13_arc[rf13_i,rf13_j]) = 1
);

constraint forall(rf13_j in rf13_vertices)(
    sum(rf13_i in rf13_vertices)(rf13_arc[rf13_i,rf13_j]) = 1
);

constraint forall(rf13_i in rf13_nodes)(
    rf13_arc[0,rf13_i] = rf13_assignment[rf13_i,rf13_first] /\
    rf13_arc[rf13_i,0] = rf13_assignment[rf13_i,rf13_last]
);

constraint forall(rf13_i,rf13_j in rf13_nodes where rf13_i != rf13_j)(
    rf13_order[rf13_j] >= rf13_order[rf13_i] + 1
        - rf13_n * (1 - rf13_arc[rf13_i,rf13_j])
);

constraint forall(rf13_i,rf13_j in rf13_nodes where rf13_i != rf13_j)(
    rf13_order[rf13_j] <= rf13_order[rf13_i] + 1
        + rf13_n * (1 - rf13_arc[rf13_i,rf13_j])
);

constraint forall(rf13_i,rf13_j in rf13_nodes where rf13_i != rf13_j)(
    rf13_arrival[rf13_j] >=
        rf13_arrival[rf13_i] + rf13_distance[rf13_i,rf13_j]
        - (rf13_time_bound + rf13_distance[rf13_i,rf13_j])
          * (1 - rf13_arc[rf13_i,rf13_j])
);

constraint forall(rf13_i,rf13_j in rf13_nodes where rf13_i != rf13_j)(
    rf13_arrival[rf13_j] <=
        rf13_arrival[rf13_i] + rf13_distance[rf13_i,rf13_j]
        + (rf13_time_bound - rf13_distance[rf13_i,rf13_j])
          * (1 - rf13_arc[rf13_i,rf13_j])
);

constraint forall(rf13_i in rf13_nodes, rf13_p in rf13_positions)(
    rf13_arrival[rf13_i] >= rf13_cumulative[rf13_p]
        - rf13_time_bound * (1 - rf13_assignment[rf13_i,rf13_p])
);

constraint forall(rf13_i in rf13_nodes, rf13_p in rf13_positions)(
    rf13_arrival[rf13_i] <= rf13_cumulative[rf13_p]
        + rf13_time_bound * (1 - rf13_assignment[rf13_i,rf13_p])
);

constraint mapget1048 =
    sum(rf13_i in rf13_nodes)(
        rf13_depot[rf13_i] * rf13_assignment[rf13_i,rf13_first]
    );

constraint mapget10815 =
    sum(rf13_i in rf13_nodes)(
        rf13_depot[rf13_i] * rf13_assignment[rf13_i,rf13_last]
    );

constraint objective =
    sum(rf13_i in rf13_nodes)(
        rf13_depot[rf13_i] *
        (rf13_arc[0,rf13_i] + rf13_arc[rf13_i,0])
    ) +
    sum(rf13_i,rf13_j in rf13_nodes where rf13_i != rf13_j)(
        rf13_distance[rf13_i,rf13_j] * rf13_arc[rf13_i,rf13_j]
    );

constraint forall(rf13_i in rf13_nodes)(
    rf13_arrival[rf13_i] >=
        min(rf13_depot) + rf13_min_edge * rf13_order[rf13_i]
);

constraint forall(rf13_i in rf13_nodes)(
    rf13_arrival[rf13_i] <=
        max(rf13_depot) + rf13_max_edge * rf13_order[rf13_i]
);

constraint forall(rf13_i in rf13_nodes
                  where rf13_i mod 2 = 1 /\ rf13_i < max(rf13_nodes))(
    rf13_order[rf13_i] + 1 <= rf13_order[rf13_i+1] /\
    rf13_arrival[rf13_i] <= rf13_arrival[rf13_i+1] /\
    rf13_arc[rf13_i+1,rf13_i] = 0 /\
    rf13_arc[0,rf13_i+1] = 0 /\
    rf13_arc[rf13_i,0] = 0
);

constraint forall(rf13_p in rf13_positions)(
    rf13_list[rf13_p] = rf13_location[rf13_p] + 5 /\
    rf13_chosen[rf13_p] = rf13_location[rf13_p] - 1 /\
    rf13_list_lookup[rf13_p] = rf13_location[rf13_p] + 1 /\
    rf13_row[rf13_p] = rf13_location[rf13_p] + 30 /\
    rf13_row_lookup[rf13_p] = rf13_location[rf13_p]
);

constraint forall(rf13_i in index_set(rf13_arrival_lookup))(
    rf13_arrival_lookup[rf13_i] = rf13_order[rf13_i] + 2
);

constraint forall(rf13_p in index_set(rf13_edge_lookup))(
    rf13_edge_lookup[rf13_p] =
        rf13_n * (rf13_location[rf13_p] - 1)
        + rf13_location[rf13_p+1]
);

constraint mapget1048X = rf13_location[rf13_first];
constraint mapget10815X = rf13_location[rf13_last];

solve minimize objective;