param MaxInstants;
set INSTANTS := 1..MaxInstants;
set INSTANTSwithzero := ({0} union INSTANTS);

param PDem{i in INSTANTS};
param DeltaT := 1;
param losscoefSEin := -0.0700000000000000;
param losscoefSEout := 0.0752688172043010;
param P_FC_max := 60;
param P_FC_min := 1;
param P_ES_max := 60;
param P_ES_min := -60;
param ES_min := 400;
param ES_max := 1600;
param ES_init := 900;

param nbeffpts;
set EFFPOINTS := 0..nbeffpts-1;
param xofeffpt_usable{i in EFFPOINTS};
param yofeffpt_cost{i in EFFPOINTS};

param rf4_charge := 1 + losscoefSEin;
param rf4_discharge := 1 + losscoefSEout;

param rf4_off_depletion{i in INSTANTS} :=
    max(rf4_charge * P_ES_min,
        rf4_charge * PDem[i],
        rf4_discharge * PDem[i]);

param rf4_point_depletion{i in INSTANTS, j in EFFPOINTS} :=
    max(rf4_charge * P_ES_min,
        rf4_charge * (PDem[i] - xofeffpt_usable[j]),
        rf4_discharge * (PDem[i] - xofeffpt_usable[j]));

var X_FC{i in INSTANTS} >= 0, <= P_FC_max;
var X_ES_in{i in INSTANTS} <= 0, >= P_ES_min;
var X_ES_out{i in INSTANTS} >= 0, <= P_ES_max;
var CostFC{i in INSTANTS} >= 0;
var Effpt{i in INSTANTS, j in EFFPOINTS} binary,
    <= (if xofeffpt_usable[j] + P_ES_max < PDem[i] then 0 else 1);

var rf4_energy{i in INSTANTSwithzero} >= ES_min, <= ES_max;

minimize TotalCost:
    sum{i in INSTANTS} CostFC[i];

s.t. SatisfyDemand{i in INSTANTS}:
    X_FC[i] + X_ES_in[i] + X_ES_out[i] >= PDem[i];

s.t. rf4_initial_energy:
    rf4_energy[0] = ES_init;

s.t. rf4_energy_balance{i in INSTANTS}:
    rf4_energy[i] = rf4_energy[i-1]
        - rf4_charge * X_ES_in[i]
        - rf4_discharge * X_ES_out[i];

s.t. RestoreInitialLevel:
    rf4_energy[MaxInstants] >= ES_init;

s.t. GetXFC{i in INSTANTS}:
    X_FC[i] = sum{j in EFFPOINTS} xofeffpt_usable[j] * Effpt[i,j];

s.t. GetEfficiencyPointCost{i in INSTANTS}:
    CostFC[i] = sum{j in EFFPOINTS} yofeffpt_cost[j] * Effpt[i,j];

s.t. OneEffPointPerInstant{i in INSTANTS}:
    (if PDem[i] > P_ES_max then 1 else 0)
    <= sum{j in EFFPOINTS} Effpt[i,j] <= 1;

s.t. rf4_disjunctive_depletion{i in INSTANTS}:
    rf4_charge * X_ES_in[i] + rf4_discharge * X_ES_out[i]
    >= rf4_off_depletion[i]
       + sum{j in EFFPOINTS}
           (rf4_point_depletion[i,j] - rf4_off_depletion[i]) * Effpt[i,j];

data;

param MaxInstants := 1400;

param PDem :=
