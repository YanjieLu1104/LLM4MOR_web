param MaxInstants;

set INSTANTS := 1..MaxInstants;
set INSTANTSwithzero := ({0} union INSTANTS);

param PDem{i in INSTANTS};

param DeltaT := 1;
param losscoefSEin := -0.0700000000000000;
param losscoefSEout := 0.0752688172043010;

param P_FC_max := 62;
param P_FC_min := 1;
param P_ES_max := 60;
param P_ES_min := -60;
param ES_min := 400;
param ES_max := 1600;
param ES_init := 900;

param nbeffpts;
set EFFPOINTS := 0..nbeffpts-1;
param xofeffpt{i in EFFPOINTS};
param yofeffpt{i in EFFPOINTS};

param rf4637097_charge := 1 + losscoefSEin;
param rf4637097_discharge := 1 + losscoefSEout;

param rf4637097_offwithdraw{i in INSTANTS} :=
    max(rf4637097_charge * P_ES_min,
        rf4637097_charge * PDem[i],
        rf4637097_discharge * PDem[i]);

param rf4637097_pointwithdraw{i in INSTANTS, j in EFFPOINTS} :=
    max(rf4637097_charge * P_ES_min,
        rf4637097_charge * (PDem[i] - yofeffpt[j]),
        rf4637097_discharge * (PDem[i] - yofeffpt[j]));

var X_FC{i in INSTANTS}, >= 0, <= P_FC_max;
var X_ES_in{i in INSTANTS}, <= 0, >= P_ES_min;
var X_ES_out{i in INSTANTS}, >= 0, <= P_ES_max;
var CostFC{i in INSTANTS}, >= 0;

var Effpt{i in INSTANTS, j in EFFPOINTS}, binary,
    <= (if yofeffpt[j] < 0
           or yofeffpt[j] > P_FC_max
           or xofeffpt[j] < 0
           or yofeffpt[j] + P_ES_max < PDem[i]
        then 0 else 1);

var rf4637097_energy{i in INSTANTSwithzero},
    >= (if i = 0 then ES_init else ES_min),
    <= (if i = 0 then ES_init else ES_max);

minimize TotalCost:
    sum{i in INSTANTS} CostFC[i];

s.t. SatisfyDemand{i in INSTANTS}:
    X_FC[i] + X_ES_in[i] + X_ES_out[i] >= PDem[i];

s.t. rf4637097_balance{i in INSTANTS}:
    rf4637097_energy[i] =
        rf4637097_energy[i-1]
        - rf4637097_charge * X_ES_in[i]
        - rf4637097_discharge * X_ES_out[i];

s.t. RestoreInitialLevel:
    rf4637097_energy[MaxInstants] >= ES_init;

s.t. GetXFC{i in INSTANTS}:
    X_FC[i] = sum{j in EFFPOINTS} yofeffpt[j] * Effpt[i,j];

s.t. GetEfficiencyPointCost{i in INSTANTS}:
    CostFC[i] = sum{j in EFFPOINTS} xofeffpt[j] * Effpt[i,j];

s.t. OneEffPointPerInstant{i in INSTANTS}:
    sum{j in EFFPOINTS} Effpt[i,j] <= 1;

s.t. rf4637097_requiredon{i in INSTANTS: PDem[i] > P_ES_max}:
    sum{j in EFFPOINTS} Effpt[i,j] = 1;

s.t. rf4637097_withdrawalcut{i in INSTANTS}:
    rf4637097_charge * X_ES_in[i]
    + rf4637097_discharge * X_ES_out[i]
    >= rf4637097_offwithdraw[i]
       + sum{j in EFFPOINTS}
           (rf4637097_pointwithdraw[i,j] - rf4637097_offwithdraw[i])
           * Effpt[i,j];

data;

param MaxInstants := 561;

