set K dimen 2;
set L dimen 2;

param A{(i,j) in K, (l,m) in K} :=
    if abs(i-l) + abs(j-m) = 0
    then 100000
    else abs(i-l) + abs(j-m);

set rf01_radii := {4, 12};

set rf01_neighborhood{(i,j) in L, rf01_radius in rf01_radii}
    dimen 2 :=
    setof {(l,m) in L:
        abs(i-l) + abs(j-m) <= rf01_radius} (l,m);

var x{(i,j) in K, (l,m) in K}
    binary,
    <= (if i = l and j = m then 0 else 1);

var y{(i,j) in K, (l,m) in K}
    >= 0,
    <= (if (i = l and j = m) or (l = -20 and m = 93)
        then 0 else 182);

minimize cost:
    sum {(i,j) in K, (l,m) in L}
        A[i,j,l,m] * x[i,j,l,m];

s.t. leave{(i,j) in K}:
    sum {(l,m) in K} x[i,j,l,m] = 1;

s.t. enter{(l,m) in K}:
    sum {(i,j) in K} x[i,j,l,m] = 1;

s.t. C1bis{(i,j) in K, (l,m) in K:
    i < l or (i = l and j < m)}:
    x[i,j,l,m] + x[l,m,i,j] <= 1;

s.t. cap{(i,j) in L, (l,m) in L:
    i != l or j != m}:
    y[i,j,l,m] <= 181 * x[i,j,l,m];

s.t. rf01_flow_lower{(i,j) in L, (l,m) in L:
    i != l or j != m}:
    y[i,j,l,m] >= x[i,j,l,m];

s.t. rf01_depot_flow{(l,m) in L}:
    y[-20,93,l,m] = 182 * x[-20,93,l,m];

s.t. node{(i,j) in L}:
    sum {(l,m) in K} y[l,m,i,j]
    =
    sum {(l,m) in K} y[i,j,l,m] + 1;

s.t. rf01_local_subtour{
    (i,j) in L, rf01_radius in rf01_radii:
    card(rf01_neighborhood[i,j,rf01_radius]) >= 3}:
    sum {
        (rf01_a,rf01_b) in rf01_neighborhood[i,j,rf01_radius],
        (rf01_c,rf01_d) in rf01_neighborhood[i,j,rf01_radius]:
        rf01_a != rf01_c or rf01_b != rf01_d
    } x[rf01_a,rf01_b,rf01_c,rf01_d]
    <= card(rf01_neighborhood[i,j,rf01_radius]) - 1;

data;

set K :=
(-20,93)
(1,50) (1,82) (1,114) (1,146)
(2,47) (2,52) (2,79) (2,84) (2,111) (2,116) (2,143) (2,148)
