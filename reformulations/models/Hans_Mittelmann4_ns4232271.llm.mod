param NLojas;
param Lojas{i in 1..NLojas};
param Produto;
param produto{i in 1..Produto};
param custo{i in 1..NLojas, j in 1..NLojas};
param Disponibilidade{i in 1..NLojas, k in 1..Produto};
param Procura{j in 1..NLojas, k in 1..Produto};

param rf1_supply_total{k in 1..Produto} :=
    sum{i in 1..NLojas} Disponibilidade[i,k]/5;

param rf1_demand_total{k in 1..Produto} :=
    sum{j in 1..NLojas} Procura[j,k]/5;

param rf1_flow_upper{i in 1..NLojas, j in 1..NLojas, k in 1..Produto} :=
    if i = j and i < NLojas then 0
    else min(Disponibilidade[i,k]/5, Procura[j,k]/5, 1000000);

param rf1_flow_lower{i in 1..NLojas, j in 1..NLojas, k in 1..Produto} :=
    if i = j and i < NLojas then 0
    else max(0,
        Disponibilidade[i,k]/5 + Procura[j,k]/5 - rf1_demand_total[k],
        Disponibilidade[i,k]/5 + Procura[j,k]/5 - rf1_supply_total[k]);

param rf1_arc_upper{i in 1..NLojas, j in 1..NLojas} :=
    min(1000000, sum{k in 1..Produto} rf1_flow_upper[i,j,k]);

var caixas{i in 1..NLojas, j in 1..NLojas, k in 1..Produto}
    >= rf1_flow_lower[i,j,k], <= rf1_flow_upper[i,j,k];

var Envios{i in 1..NLojas, j in 1..NLojas}, binary;

minimize EnviosTotal:
    sum{i in 1..NLojas, j in 1..NLojas} custo[i,j]*Envios[i,j];

subject to Packing{i in 1..NLojas, j in 1..NLojas}:
    sum{k in 1..Produto} caixas[i,j,k] <= rf1_arc_upper[i,j]*Envios[i,j];

subject to rf1_commodity_activation{
    i in 1..NLojas, j in 1..NLojas, k in 1..Produto:
    rf1_flow_upper[i,j,k] > 0}:
    caixas[i,j,k] <= rf1_flow_upper[i,j,k]*Envios[i,j];

subject to Disponivel{i in 1..NLojas, k in 1..Produto}:
    sum{j in 1..NLojas} caixas[i,j,k] = Disponibilidade[i,k]/5;

subject to PROCURA{j in 1..NLojas, k in 1..Produto}:
    sum{i in 1..NLojas} caixas[i,j,k] = Procura[j,k]/5;

data;

param Produto := 10;
param NLojas := 61;

