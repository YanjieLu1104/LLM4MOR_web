var 1..196: mapget10165X;
var 1..14: mapget10786X;
var 1..14: mapget10815X;

array[int] of int: rf2_depot =
    [6,9,14,15,10,15,13,18,10,13,6,9,2,7];

set of int: rf2_nodes = index_set(rf2_depot);
int: rf2_n = length(rf2_depot);
int: rf2_first = min(rf2_nodes);
int: rf2_last = max(rf2_nodes);
int: rf2_base = rf2_first - 1;
set of int: rf2_vertices = rf2_base..rf2_last;
set of int: rf2_steps = rf2_first..(rf2_last - 1);

array[rf2_nodes, rf2_nodes] of int: rf2_distance =
    array2d(rf2_nodes, rf2_nodes, [
        0,8,15,7,14,13,11,3,1,1,19,15,18,15,
        8,0,5,19,18,3,20,6,16,9,10,6,9,1,
        15,5,0,9,4,17,15,15,15,1,5,9,3,14,
        7,19,9,0,3,10,20,1,16,18,5,20,2,6,
        14,18,4,3,0,17,19,7,1,13,1,17,9,2,
        13,3,17,10,17,0,14,4,18,14,12,16,6,2,
        11,20,15,20,19,14,0,16,18,17,7,19,10,17,
        3,6,15,1,7,4,16,0,18,16,4,3,20,11,
        1,16,15,16,1,18,18,18,0,17,19,8,16,15,
        1,9,1,18,13,14,17,16,17,0,17,13,20,13,
        19,10,5,5,1,12,7,4,19,17,0,12,11,15,
        15,6,9,20,17,16,19,3,8,13,12,0,18,16,
        18,9,3,2,9,6,10,20,16,20,11,18,0,15,
        15,1,14,6,2,2,17,11,15,13,15,16,15,0
    ]);

array[rf2_nodes] of var 0..13: rf2_order = [
    chooseOrder200, chooseOrder234, chooseOrder270, chooseOrder308,
    chooseOrder348, chooseOrder390, chooseOrder434, chooseOrder480,
    chooseOrder528, chooseOrder578, chooseOrder630, chooseOrder684,
    chooseOrder740, chooseOrder798
];

array[rf2_nodes] of var 6..19: rf2_list = [
    listget899, listget1112, listget2256, listget2966,
    listget3676, listget4386, listget5096, listget5806,
    listget6516, listget7226, listget7936, listget8646,
    listget9356, listget10066
];

