    initialFieldValueslocationID966, initialFieldValueslocationID1165,
    initialFieldValueslocationID2309, initialFieldValueslocationID3019,
    initialFieldValueslocationID3729, initialFieldValueslocationID4439,
    initialFieldValueslocationID5149, initialFieldValueslocationID5859,
    initialFieldValueslocationID6569, initialFieldValueslocationID7279,
    initialFieldValueslocationID7989, initialFieldValueslocationID8699,
    initialFieldValueslocationID9409, initialFieldValueslocationID10119
];

array[rf2_nodes] of var 31..44: rf2_row = [
    mapget1182, mapget2326, mapget3036, mapget3746,
    mapget4456, mapget5166, mapget5876, mapget6586,
    mapget7296, mapget8006, mapget8716, mapget9426,
    mapget10136, mapget10786
];

array[rf2_nodes] of var 1..14: rf2_row_index = [
    mapget1182X, mapget2326X, mapget3036X, mapget3746X,
    mapget4456X, mapget5166X, mapget5876X, mapget6586X,
    mapget7296X, mapget8006X, mapget8716X, mapget9426X,
    mapget10136X, mapget10786X
];

array[rf2_steps] of var 0..20: rf2_leg = [
    mapget1645, mapget2355, mapget3065, mapget3775,
    mapget4485, mapget5195, mapget5905, mapget6615,
    mapget7325, mapget8035, mapget8745, mapget9455,
    mapget10165
];

array[rf2_steps] of var 1..196: rf2_leg_index = [
    mapget1645X, mapget2355X, mapget3065X, mapget3775X,
    mapget4485X, mapget5195X, mapget5905X, mapget6615X,
    mapget7325X, mapget8035X, mapget8745X, mapget9455X,
    mapget10165X
];

array[rf2_nodes] of var 2..278: rf2_prefix = [
    mapget1048, binop2235, binop2945, binop3655,
    binop4365, binop5075, binop5785, binop6495,
    binop7205, binop7915, binop8625, binop9335,
    binop10045, binop10755
];

array[rf2_nodes] of var 0..278: rf2_arrival = [
    expectedArrivalTime11026, expectedArrivalTime11029,
    expectedArrivalTime11040, expectedArrivalTime11043,
    expectedArrivalTime11054, expectedArrivalTime11057,
    expectedArrivalTime11068, expectedArrivalTime11071,
    expectedArrivalTime11082, expectedArrivalTime11085,
    expectedArrivalTime11096, expectedArrivalTime11099,
    expectedArrivalTime11110, expectedArrivalTime11113
];

array[rf2_nodes] of var 1..15: rf2_arrival_index = [
    expectedArrivalTimeX14, expectedArrivalTimeX15,
    expectedArrivalTimeX16, expectedArrivalTimeX17,
    expectedArrivalTimeX18, expectedArrivalTimeX19,
    expectedArrivalTimeX20, expectedArrivalTimeX21,
    expectedArrivalTimeX22, expectedArrivalTimeX23,
    expectedArrivalTimeX24, expectedArrivalTimeX25,
    expectedArrivalTimeX26, expectedArrivalTimeX27
];

array[rf2_nodes] of var 1..15: rf2_list_index = [
    listget899X, listget1112X, listget2256X, listget2966X,
    listget3676X, listget4386X, listget5096X, listget5806X,
    listget6516X, listget7226X, listget7936X, listget8646X,
    listget9356X, listget10066X
];

array[rf2_nodes, rf2_nodes] of var 0..1: rf2_assignment;
array[rf2_vertices, rf2_vertices] of var 0..1: rf2_arc;

constraint forall(rf2_i in rf2_nodes)(
    sum(rf2_p in rf2_nodes)(rf2_assignment[rf2_i, rf2_p]) = 1
);

constraint forall(rf2_p in rf2_nodes)(
    sum(rf2_i in rf2_nodes)(rf2_assignment[rf2_i, rf2_p]) = 1
);

constraint forall(rf2_i in rf2_nodes)(
    rf2_order[rf2_i] =
        sum(rf2_p in rf2_nodes)(
            (rf2_p - rf2_first) * rf2_assignment[rf2_i, rf2_p]
        )
);

constraint forall(rf2_p in rf2_nodes)(
    rf2_location[rf2_p] =
        sum(rf2_i in rf2_nodes)(
            rf2_i * rf2_assignment[rf2_i, rf2_p]
        )
);

constraint forall(rf2_p in rf2_nodes)(
    rf2_list[rf2_p] = rf2_location[rf2_p] + 5 /\
    rf2_chosen[rf2_p] = rf2_location[rf2_p] - 1 /\
    rf2_list_index[rf2_p] = rf2_location[rf2_p] + 1 /\
    rf2_row[rf2_p] = rf2_location[rf2_p] + 30 /\
    rf2_row_index[rf2_p] = rf2_location[rf2_p]
);

constraint forall(rf2_i in rf2_nodes)(
    rf2_arrival_index[rf2_i] = rf2_order[rf2_i] + 2 /\
    rf2_arrival[rf2_i] >= 2
);

constraint mapget1048X = rf2_location[rf2_first];
constraint mapget10815X = rf2_location[rf2_last];

constraint mapget1048 =
    sum(rf2_i in rf2_nodes)(
        rf2_depot[rf2_i] * rf2_assignment[rf2_i, rf2_first]
    );

constraint mapget10815 =
    sum(rf2_i in rf2_nodes)(
        rf2_depot[rf2_i] * rf2_assignment[rf2_i, rf2_last]
    );

constraint forall(rf2_p in rf2_steps)(
    rf2_leg_index[rf2_p] =
        rf2_n * (rf2_location[rf2_p] - 1) + rf2_location[rf2_p + 1] /\
    rf2_leg[rf2_p] = rf2_prefix[rf2_p + 1] - rf2_prefix[rf2_p]
);

constraint forall(rf2_i in rf2_nodes, rf2_p in rf2_nodes)(
    rf2_arrival[rf2_i] - rf2_prefix[rf2_p]
        <= 276 * (1 - rf2_assignment[rf2_i, rf2_p]) /\
    rf2_prefix[rf2_p] - rf2_arrival[rf2_i]
        <= 276 * (1 - rf2_assignment[rf2_i, rf2_p])
);

constraint forall(rf2_i in rf2_vertices)(
    rf2_arc[rf2_i, rf2_i] = 0 /\
    sum(rf2_j in rf2_vertices)(rf2_arc[rf2_i, rf2_j]) = 1 /\
    sum(rf2_j in rf2_vertices)(rf2_arc[rf2_j, rf2_i]) = 1
);

constraint forall(rf2_i in rf2_nodes)(
    rf2_arc[rf2_base, rf2_i] = rf2_assignment[rf2_i, rf2_first] /\
    rf2_arc[rf2_i, rf2_base] = rf2_assignment[rf2_i, rf2_last]
);

constraint forall(
    rf2_i in rf2_nodes,
    rf2_j in rf2_nodes
    where rf2_i != rf2_j
)(
    rf2_order[rf2_i] - rf2_order[rf2_j]
        + rf2_n * rf2_arc[rf2_i, rf2_j]
        + (rf2_n - 2) * rf2_arc[rf2_j, rf2_i]
        <= rf2_n - 1
);

constraint forall(rf2_i in rf2_nodes)(
    rf2_arrival[rf2_i] - rf2_depot[rf2_i]
        <= (278 - rf2_depot[rf2_i])
            * (1 - rf2_arc[rf2_base, rf2_i]) /\
    rf2_depot[rf2_i] - rf2_arrival[rf2_i]
        <= (rf2_depot[rf2_i] - 2)
            * (1 - rf2_arc[rf2_base, rf2_i])
);

constraint forall(
    rf2_i in rf2_nodes,
    rf2_j in rf2_nodes
    where rf2_i != rf2_j
)(
    rf2_arrival[rf2_j] >=
        rf2_arrival[rf2_i] + rf2_distance[rf2_i, rf2_j]
        - (276 + rf2_distance[rf2_i, rf2_j])
            * (1 - rf2_arc[rf2_i, rf2_j]) /\
    rf2_arrival[rf2_j] <=
        rf2_arrival[rf2_i] + rf2_distance[rf2_i, rf2_j]
        + (276 - rf2_distance[rf2_i, rf2_j])
            * (1 - rf2_arc[rf2_i, rf2_j])
);

constraint forall(
    rf2_i in rf2_nodes
    where rf2_i mod 2 = 1 /\ rf2_i < rf2_last
)(
    rf2_order[rf2_i] + 1 <= rf2_order[rf2_i + 1] /\
    rf2_arrival[rf2_i] <= rf2_arrival[rf2_i + 1]
);

constraint objective =
    sum(rf2_i in rf2_nodes)(
        rf2_depot[rf2_i]
            * (rf2_arc[rf2_base, rf2_i] + rf2_arc[rf2_i, rf2_base])
    )
    + sum(
        rf2_i in rf2_nodes,
        rf2_j in rf2_nodes
        where rf2_i != rf2_j
    )(
        rf2_distance[rf2_i, rf2_j] * rf2_arc[rf2_i, rf2_j]
    );

solve minimize objective;